<Window x:Class="NativeSceneProbe.WpfFixture.ProbeFixtureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Native Scene Probe Fixture"
        Width="900" Height="640"
        MinWidth="900" MaxWidth="900"
        MinHeight="640" MaxHeight="640"
        Left="120" Top="120"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AutomationProperties.AutomationId="NativeSceneProbeWindow"
        AutomationProperties.Name="Native Scene Probe Fixture">
    <Grid Background="#FFF4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="96" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="32,24" Background="#FF1F3A52">
            <TextBlock x:Name="SceneHeading"
                       Text="Gallery / Button.Primary"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="SemiBold"
                       AutomationProperties.AutomationId="SceneHeading"
                       AutomationProperties.Name="Gallery Button Primary" />
        </Border>

        <Border x:Name="SceneRoot"
                Grid.Row="1"
                Margin="32,24"
                Padding="24"
                Background="White"
                BorderBrush="#FFB7C5D0"
                BorderThickness="1"
                CornerRadius="4"
                AutomationProperties.AutomationId="Gallery"
                AutomationProperties.Name="Gallery fixture root"
                AutomationProperties.HelpText="fixtureId=Gallery">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Deterministic fixture scene"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="SceneTitle"
                                   AutomationProperties.Name="Deterministic fixture scene" />
                        <TextBlock Text="Visible controls expose controlled accessibility and geometry facts."
                                   Margin="0,6,0,0"
                                   Foreground="#FF40566A"
                                   AutomationProperties.AutomationId="SceneDescription"
                                   AutomationProperties.Name="Fixture scene description" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Probe-owned revision"
                                   FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="RevisionLabel"
                                   AutomationProperties.Name="Probe-owned revision label" />
                        <TextBox x:Name="RevisionValue"
                                 Margin="0,6,0,0"
                                 Height="32"
                                 IsReadOnly="True"
                                 IsTabStop="False"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.AutomationId="ProbeRevision"
                                 AutomationProperties.Name="Probe-owned revision" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SaveButton"
                            Width="260"
                            Height="56"
                            HorizontalAlignment="Left"
                            Content="Save scene"
                            Tag="Button.Primary"
                            AutomationProperties.AutomationId="SaveButton"
                            AutomationProperties.Name="Save scene"
                            AutomationProperties.HelpText="contractId=Button.Primary" />
                    <Border Grid.Column="2"
                            Padding="16"
                            Background="#FFE8F0F5"
                            BorderBrush="#FFB7C5D0"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock Text="Unique canonical identity: Button.Primary; fallback AutomationId: SaveButton"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="PrimaryIdentityDescription"
                                   AutomationProperties.Name="Primary identity description" />
                    </Border>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Observed items"
                              Padding="12"
                              AutomationProperties.AutomationId="ObservedItems"
                              AutomationProperties.Name="Observed fixture items">
                        <ListBox AutomationProperties.AutomationId="ObservedItemsList"
                                 AutomationProperties.Name="Observed fixture items list">
                            <ListBoxItem Content="Alpha" />
                            <ListBoxItem Content="Beta" />
                            <ListBoxItem Content="Gamma" />
                        </ListBox>
                    </GroupBox>
                    <GroupBox Grid.Column="2"
                              Header="Ambiguous fallback identity"
                              Padding="12"
                              AutomationProperties.AutomationId="AmbiguousIdentityRegion"
                              AutomationProperties.Name="Ambiguous fallback identity region">
                        <StackPanel>
                            <Button x:Name="FirstAmbiguousButton"
                                    Height="40"
                                    Margin="0,0,0,8"
                                    Content="Ambiguous action one"
                                    Tag="Button.Duplicate"
                                    AutomationProperties.AutomationId="AmbiguousButton"
                                    AutomationProperties.Name="Ambiguous action one"
                                    AutomationProperties.HelpText="contractId=Button.Duplicate" />
                            <Button x:Name="SecondAmbiguousButton"
                                    Height="40"
                                    Content="Ambiguous action two"
                                    Tag="Button.Duplicate"
                                    AutomationProperties.AutomationId="AmbiguousButton"
                                    AutomationProperties.Name="Ambiguous action two"
                                    AutomationProperties.HelpText="contractId=Button.Duplicate" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="32,16" Background="#FFDFE7EC">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ModeValue"
                           AutomationProperties.AutomationId="ProbeMode"
                           AutomationProperties.Name="Fixture mode" />
                <TextBlock x:Name="EvidenceValue"
                           Grid.Column="1"
                           HorizontalAlignment="Right"
                           AutomationProperties.AutomationId="ProbeEvidence"
                           AutomationProperties.Name="Fixture evidence state" />
            </Grid>
        </Border>
    </Grid>
</Window>
