{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebtf.github.io/netcoredbg-mcp/schemas/diagnostic-inventory-v1.json",
  "title": "Complete exact-head SonarQube diagnostic inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "write_mode",
    "identity",
    "issues",
    "hotspots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "write_mode": {
      "const": "create_new"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_head",
        "project_key",
        "analysis_id"
      ],
      "properties": {
        "captured_head": {
          "$ref": "#/$defs/sha40"
        },
        "project_key": {
          "const": "thebtf_netcoredbg_mcp"
        },
        "analysis_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issues": {
      "$ref": "#/$defs/issue_inventory"
    },
    "hotspots": {
      "$ref": "#/$defs/hotspot_inventory"
    }
  },
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path_or_null": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        }
      ]
    },
    "inventory_page_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "result_empty",
        "page_size",
        "page_count",
        "total",
        "record_count",
        "keys_sha256",
        "blocking_key_count",
        "blocking_keys_sha256"
      ],
      "properties": {
        "complete": {
          "const": true
        },
        "result_empty": {
          "type": "boolean"
        },
        "page_size": {
          "type": "integer",
          "minimum": 1
        },
        "page_count": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "keys_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "blocking_key_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_keys_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result_empty": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "total": {
                "const": 0
              },
              "record_count": {
                "const": 0
              },
              "blocking_key_count": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "total": {
                "minimum": 1
              },
              "record_count": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "issue_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "component",
        "path",
        "rule",
        "status",
        "resolution",
        "type",
        "severity"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relative_path_or_null"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hotspot_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "component",
        "path",
        "rule",
        "status"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relative_path_or_null"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issue_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pagination",
        "records"
      ],
      "properties": {
        "pagination": {
          "$ref": "#/$defs/inventory_page_evidence"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue_record"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pagination": {
                "properties": {
                  "result_empty": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "records": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "records": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "hotspot_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pagination",
        "records"
      ],
      "properties": {
        "pagination": {
          "$ref": "#/$defs/inventory_page_evidence"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hotspot_record"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pagination": {
                "properties": {
                  "result_empty": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "records": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "records": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
