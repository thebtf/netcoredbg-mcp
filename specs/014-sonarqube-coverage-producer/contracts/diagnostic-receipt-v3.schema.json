{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebtf.github.io/netcoredbg-mcp/schemas/sonarqube-diagnostic-receipt-v3.json",
  "title": "Exact-head SonarQube coverage diagnostic receipt v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "outcome",
    "release_intent",
    "captured_head",
    "project_key",
    "coverage",
    "analysis",
    "unresolved_global_blockers",
    "cleanup",
    "failure"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "role": {
      "const": "diagnostic"
    },
    "outcome": {
      "enum": [
        "DIAGNOSTIC_COMPLETE",
        "BLOCKED"
      ]
    },
    "release_intent": {
      "const": "none"
    },
    "captured_head": {
      "$ref": "#/$defs/sha40"
    },
    "project_key": {
      "const": "thebtf_netcoredbg_mcp"
    },
    "coverage": {
      "oneOf": [
        {
          "$ref": "#/$defs/coverage_evidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "analysis": {
      "oneOf": [
        {
          "$ref": "#/$defs/analysis_evidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "unresolved_global_blockers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "current_issue_count",
        "blocking_issue_count",
        "hotspot_count"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "current_issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "hotspot_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cleanup": {
      "oneOf": [
        {
          "$ref": "#/$defs/cleanup"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "oneOf": [
        {
          "$ref": "#/$defs/failure"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "DIAGNOSTIC_COMPLETE"
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "$ref": "#/$defs/coverage_evidence"
          },
          "analysis": {
            "$ref": "#/$defs/analysis_evidence"
          },
          "cleanup": {
            "allOf": [
              {
                "$ref": "#/$defs/cleanup"
              },
              {
                "properties": {
                  "status": {
                    "const": "OK"
                  }
                }
              }
            ]
          },
          "failure": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "analysis_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_id",
        "revision"
      ],
      "properties": {
        "analysis_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/sha40"
        }
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256",
        "bytes",
        "schema_version"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "schema_version": {
          "const": 1
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "format",
        "relative_path",
        "sha256",
        "bytes",
        "xml_root",
        "denominator",
        "covered_count",
        "branch_denominator",
        "branch_covered_count",
        "source_paths",
        "source_set_sha256"
      ],
      "properties": {
        "id": {
          "enum": [
            "python",
            "codesearch-core",
            "host",
            "stateless-preview",
            "stateless",
            "host-prompts"
          ]
        },
        "language": {
          "enum": [
            "python",
            "dotnet"
          ]
        },
        "format": {
          "enum": [
            "cobertura",
            "opencover"
          ]
        },
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "xml_root": {
          "enum": [
            "coverage",
            "CoverageSession"
          ]
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        },
        "covered_count": {
          "type": "integer",
          "minimum": 0
        },
        "branch_denominator": {
          "type": "integer",
          "minimum": 0
        },
        "branch_covered_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relative_path"
          },
          "uniqueItems": true
        },
        "source_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "language": {
                "const": "python"
              }
            }
          },
          "then": {
            "properties": {
              "format": {
                "const": "cobertura"
              },
              "xml_root": {
                "const": "coverage"
              },
              "branch_denominator": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "language": {
                "const": "dotnet"
              }
            }
          },
          "then": {
            "properties": {
              "format": {
                "const": "opencover"
              },
              "xml_root": {
                "const": "CoverageSession"
              }
            }
          }
        }
      ]
    },
    "coverage_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "marker",
        "reports",
        "python_totals",
        "dotnet_totals",
        "stateless_host_binary"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "marker": {
          "$ref": "#/$defs/marker"
        },
        "reports": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/report"
          }
        },
        "python_totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lines_valid",
            "lines_covered",
            "branches_valid",
            "branches_covered"
          ],
          "properties": {
            "lines_valid": {
              "type": "integer",
              "minimum": 1
            },
            "lines_covered": {
              "type": "integer",
              "minimum": 0
            },
            "branches_valid": {
              "type": "integer",
              "minimum": 1
            },
            "branches_covered": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "dotnet_totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence_points",
            "visited_sequence_points",
            "branch_points",
            "visited_branch_points"
          ],
          "properties": {
            "sequence_points": {
              "type": "integer",
              "minimum": 1
            },
            "visited_sequence_points": {
              "type": "integer",
              "minimum": 0
            },
            "branch_points": {
              "type": "integer",
              "minimum": 1
            },
            "visited_branch_points": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stateless_host_binary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dll_before",
            "dll_after",
            "pdb_before",
            "pdb_after"
          ],
          "properties": {
            "dll_before": {
              "$ref": "#/$defs/sha256"
            },
            "dll_after": {
              "$ref": "#/$defs/sha256"
            },
            "pdb_before": {
              "$ref": "#/$defs/sha256"
            },
            "pdb_after": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "language_component_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_set_sha256",
        "page_count",
        "complete",
        "mapped_path_count",
        "lines_to_cover",
        "covered_lines",
        "branch_measure_path_count",
        "mapped_paths_sha256"
      ],
      "properties": {
        "source_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "complete": {
          "const": true
        },
        "mapped_path_count": {
          "type": "integer",
          "minimum": 1
        },
        "lines_to_cover": {
          "type": "integer",
          "minimum": 1
        },
        "covered_lines": {
          "type": "integer",
          "minimum": 1
        },
        "branch_measure_path_count": {
          "type": "integer",
          "minimum": 1
        },
        "mapped_paths_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "analysis_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted",
        "current_before_measures",
        "current_after_measures",
        "current_final",
        "aggregate",
        "new_coverage_condition",
        "python_components",
        "dotnet_components"
      ],
      "properties": {
        "submitted": {
          "$ref": "#/$defs/analysis_identity"
        },
        "current_before_measures": {
          "$ref": "#/$defs/analysis_identity"
        },
        "current_after_measures": {
          "$ref": "#/$defs/analysis_identity"
        },
        "current_final": {
          "$ref": "#/$defs/analysis_identity"
        },
        "aggregate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage",
            "lines_to_cover",
            "uncovered_lines",
            "line_coverage",
            "branch_coverage",
            "new_coverage",
            "new_lines_to_cover",
            "new_uncovered_lines",
            "new_line_coverage",
            "new_branch_coverage"
          ],
          "properties": {
            "coverage": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "lines_to_cover": {
              "type": "integer",
              "minimum": 1
            },
            "uncovered_lines": {
              "type": "integer",
              "minimum": 0
            },
            "line_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "branch_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "new_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "new_lines_to_cover": {
              "type": "integer",
              "minimum": 1
            },
            "new_uncovered_lines": {
              "type": "integer",
              "minimum": 0
            },
            "new_line_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "new_branch_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "new_coverage_condition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "threshold",
            "actual_value"
          ],
          "properties": {
            "status": {
              "const": "OK"
            },
            "threshold": {
              "const": 80
            },
            "actual_value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "python_components": {
          "$ref": "#/$defs/language_component_evidence"
        },
        "dotnet_components": {
          "$ref": "#/$defs/language_component_evidence"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed_root",
        "producer_terminal",
        "removed_paths",
        "parent_removed_if_empty",
        "status",
        "failure"
      ],
      "properties": {
        "claimed_root": {
          "$ref": "#/$defs/relative_path"
        },
        "producer_terminal": {
          "const": true
        },
        "removed_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relative_path"
          },
          "uniqueItems": true
        },
        "parent_removed_if_empty": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "OK",
            "FAILED"
          ]
        },
        "failure": {
          "oneOf": [
            {
              "$ref": "#/$defs/safe_failure"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "safe_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "stage",
        "language",
        "project_id",
        "safe_message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^COVERAGE_[A-Z0-9_]+$"
        },
        "stage": {
          "enum": [
            "PLANNED",
            "SCANNER_BEGUN",
            "RUN_CLAIMED",
            "PRODUCING",
            "REPORTS_VALIDATED",
            "SCANNER_ENDED",
            "ANALYSIS_BOUND",
            "CLEANED",
            "BLOCKED"
          ]
        },
        "language": {
          "enum": [
            "python",
            "dotnet",
            null
          ]
        },
        "project_id": {
          "enum": [
            "python",
            "codesearch-core",
            "host",
            "stateless-preview",
            "stateless",
            "host-prompts",
            null
          ]
        },
        "safe_message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
