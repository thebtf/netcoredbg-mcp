{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A1 preview Remote Observation Receipt",
  "description": "Immutable Observation 2.0 of exact destination bytes and at most two original operation results for one advancement block; no credentials or raw diagnostics.",
  "$comment": "Resolve the exact Candidate/attempt. Re-derive canonical intent hash, discriminated target, exact postcondition and outcome. CONFIRMED requires valid ACK plus MATCH; RECONCILED requires UNKNOWN plus MATCH and attests state, not exclusive sender attribution. DENIED/CONFLICT never become reconciled success. Initial O0 has no results without a predecessor; recovery preserves original IDs and refusal/UNKNOWN history. Null sent_at means unobserved, never not-sent. Missing, unreadable or mismatched UNKNOWN cannot permit resend. Publication reconciliation resolves the genuine retained pre-publication fragment and compares exact release/asset IDs and downloaded bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_schema_version",
    "observation_id",
    "promotion_attempt_id",
    "candidate_identity_record",
    "candidate",
    "retained_artifact_availability",
    "tag_observation",
    "release_observation",
    "asset_observations",
    "readback_status",
    "operation_results",
    "observed_at"
  ],
  "properties": {
    "observation_schema_version": {
      "const": "2.0"
    },
    "observation_id": {
      "$ref": "#/$defs/safe_opaque_id"
    },
    "promotion_attempt_id": {
      "$ref": "#/$defs/safe_opaque_id"
    },
    "candidate_identity_record": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "candidate": {
      "$ref": "candidate-identity.schema.json#/$defs/candidate_binding"
    },
    "retained_artifact_availability": {
      "$ref": "#/$defs/retained_artifact_availability"
    },
    "tag_observation": {
      "$ref": "#/$defs/tag_observation"
    },
    "release_observation": {
      "$ref": "#/$defs/release_observation"
    },
    "asset_observations": {
      "$ref": "#/$defs/asset_observations"
    },
    "readback_status": {
      "$ref": "#/$defs/readback_status"
    },
    "operation_results": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/operation_result"
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "operation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_attempt_id",
        "operation",
        "intent_sha256",
        "target",
        "sent_at",
        "response",
        "postcondition",
        "outcome"
      ],
      "properties": {
        "origin_attempt_id": {
          "$ref": "#/$defs/safe_opaque_id"
        },
        "operation": {
          "enum": [
            "CREATE_TAG",
            "CREATE_DRAFT",
            "UPLOAD_ARCHIVE",
            "UPLOAD_MANIFEST",
            "PUBLISH_RELEASE"
          ]
        },
        "intent_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target": {
          "type": "object"
        },
        "sent_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "response": {
          "$ref": "#/$defs/operation_response"
        },
        "postcondition": {
          "enum": [
            "MATCH",
            "ABSENT",
            "UNREADABLE",
            "MISMATCH"
          ]
        },
        "outcome": {
          "enum": [
            "CONFIRMED",
            "RECONCILED",
            "DENIED",
            "COLLISION",
            "UNKNOWN"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "operation": {
              "const": "CREATE_TAG"
            },
            "target": {
              "$ref": "#/$defs/tag_target"
            }
          }
        },
        {
          "properties": {
            "operation": {
              "const": "CREATE_DRAFT"
            },
            "target": {
              "$ref": "#/$defs/draft_target"
            }
          }
        },
        {
          "properties": {
            "operation": {
              "const": "UPLOAD_ARCHIVE"
            },
            "target": {
              "$ref": "#/$defs/archive_target"
            }
          }
        },
        {
          "properties": {
            "operation": {
              "const": "UPLOAD_MANIFEST"
            },
            "target": {
              "$ref": "#/$defs/manifest_target"
            }
          }
        },
        {
          "properties": {
            "operation": {
              "const": "PUBLISH_RELEASE"
            },
            "target": {
              "$ref": "#/$defs/publication_target"
            }
          }
        }
      ]
    },
    "operation_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "http_status",
        "git_returncode",
        "resource_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ACKNOWLEDGED",
            "DENIED",
            "CONFLICT",
            "UNKNOWN"
          ]
        },
        "http_status": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          ]
        },
        "git_returncode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "resource_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/github_identifier"
            }
          ]
        }
      }
    },
    "tag_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "candidate_identity_record",
        "tag",
        "object_id"
      ],
      "properties": {
        "repository": {
          "$ref": "candidate-identity.schema.json#/$defs/github_repository"
        },
        "candidate_identity_record": {
          "$ref": "#/$defs/github_artifact_file_reference"
        },
        "tag": {
          "$ref": "#/$defs/tag"
        },
        "object_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "draft_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "candidate_identity_record",
        "tag",
        "source_commit"
      ],
      "properties": {
        "repository": {
          "$ref": "candidate-identity.schema.json#/$defs/github_repository"
        },
        "candidate_identity_record": {
          "$ref": "#/$defs/github_artifact_file_reference"
        },
        "tag": {
          "$ref": "#/$defs/tag"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "archive_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "candidate_identity_record",
        "release_id",
        "descriptor"
      ],
      "properties": {
        "repository": {
          "$ref": "candidate-identity.schema.json#/$defs/github_repository"
        },
        "candidate_identity_record": {
          "$ref": "#/$defs/github_artifact_file_reference"
        },
        "release_id": {
          "$ref": "#/$defs/github_identifier"
        },
        "descriptor": {
          "$ref": "#/$defs/archive"
        }
      }
    },
    "manifest_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "candidate_identity_record",
        "release_id",
        "descriptor"
      ],
      "properties": {
        "repository": {
          "$ref": "candidate-identity.schema.json#/$defs/github_repository"
        },
        "candidate_identity_record": {
          "$ref": "#/$defs/github_artifact_file_reference"
        },
        "release_id": {
          "$ref": "#/$defs/github_identifier"
        },
        "descriptor": {
          "$ref": "#/$defs/manifest"
        }
      }
    },
    "publication_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "candidate_identity_record",
        "release_id",
        "pre_publication_verification"
      ],
      "properties": {
        "repository": {
          "$ref": "candidate-identity.schema.json#/$defs/github_repository"
        },
        "candidate_identity_record": {
          "$ref": "#/$defs/github_artifact_file_reference"
        },
        "release_id": {
          "$ref": "#/$defs/github_identifier"
        },
        "pre_publication_verification": {
          "$ref": "#/$defs/github_artifact_file_reference"
        }
      }
    },
    "safe_opaque_id": {
      "$ref": "artifact-consumer-proof.schema.json#/$defs/safe_opaque_id"
    },
    "expected_result_code": {
      "$ref": "artifact-consumer-proof.schema.json#/$defs/expected_result_code"
    },
    "observed_result_code": {
      "$ref": "artifact-consumer-proof.schema.json#/$defs/observed_result_code"
    },
    "github_identifier": {
      "$ref": "candidate-identity.schema.json#/$defs/github_identifier"
    },
    "github_artifact_file_reference": {
      "$ref": "candidate-identity.schema.json#/$defs/github_artifact_file_reference"
    },
    "sha256": {
      "$ref": "candidate-identity.schema.json#/$defs/sha256"
    },
    "tag": {
      "$ref": "../../005-stateless-preview/contracts/preview-manifest.schema.json#/$defs/tag"
    },
    "archive": {
      "$ref": "../../005-stateless-preview/contracts/preview-manifest.schema.json#/$defs/archive"
    },
    "manifest": {
      "$ref": "candidate-identity.schema.json#/$defs/manifest_file"
    },
    "retained_artifact_availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observed_result"
      ],
      "properties": {
        "status": {
          "enum": [
            "AVAILABLE_AND_VERIFIED",
            "UNAVAILABLE",
            "EXPIRED",
            "IDENTITY_MISMATCH",
            "UNREADABLE"
          ]
        },
        "observed_result": {
          "$ref": "#/$defs/observed_result_code"
        }
      }
    },
    "readback_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_result",
        "observed_result",
        "reason_code"
      ],
      "properties": {
        "expected_result": {
          "allOf": [
            {
              "$ref": "#/$defs/expected_result_code"
            },
            {
              "const": "EXPECT_SUCCESS"
            }
          ]
        },
        "observed_result": {
          "$ref": "#/$defs/observed_result_code"
        },
        "reason_code": {
          "enum": [
            "READBACK_COMPLETE",
            "READBACK_UNAVAILABLE",
            "READBACK_UNAUTHORIZED",
            "READBACK_INCOMPLETE",
            "READBACK_EVIDENCE_REJECTED"
          ]
        }
      }
    },
    "tag_absent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "ABSENT"
        }
      }
    },
    "tag_present": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "tag",
        "tag_type",
        "object_id",
        "peeled_commit"
      ],
      "properties": {
        "status": {
          "const": "PRESENT"
        },
        "tag": {
          "$ref": "#/$defs/tag"
        },
        "tag_type": {
          "enum": [
            "ANNOTATED",
            "LIGHTWEIGHT"
          ]
        },
        "object_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "peeled_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "tag_unreadable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code"
      ],
      "properties": {
        "status": {
          "const": "UNREADABLE"
        },
        "reason_code": {
          "enum": [
            "TAG_READBACK_UNAVAILABLE",
            "TAG_READBACK_UNAUTHORIZED",
            "TAG_READBACK_INCOMPLETE"
          ]
        }
      }
    },
    "tag_observation": {
      "oneOf": [
        {
          "$ref": "#/$defs/tag_absent"
        },
        {
          "$ref": "#/$defs/tag_present"
        },
        {
          "$ref": "#/$defs/tag_unreadable"
        }
      ]
    },
    "release_absent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "ABSENT"
        }
      }
    },
    "release_present": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "release_id",
        "tag",
        "is_draft",
        "is_prerelease",
        "destination_metadata_status"
      ],
      "properties": {
        "status": {
          "const": "PRESENT"
        },
        "release_id": {
          "$ref": "#/$defs/github_identifier"
        },
        "tag": {
          "$ref": "#/$defs/tag"
        },
        "is_draft": {
          "type": "boolean"
        },
        "is_prerelease": {
          "type": "boolean"
        },
        "destination_metadata_status": {
          "enum": [
            "MATCHING",
            "MISMATCHED"
          ]
        }
      }
    },
    "release_unreadable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code"
      ],
      "properties": {
        "status": {
          "const": "UNREADABLE"
        },
        "reason_code": {
          "enum": [
            "RELEASE_READBACK_UNAVAILABLE",
            "RELEASE_READBACK_UNAUTHORIZED",
            "RELEASE_READBACK_INCOMPLETE"
          ]
        }
      }
    },
    "release_observation": {
      "oneOf": [
        {
          "$ref": "#/$defs/release_absent"
        },
        {
          "$ref": "#/$defs/release_present"
        },
        {
          "$ref": "#/$defs/release_unreadable"
        }
      ]
    },
    "archive_asset_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "size_bytes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/github_identifier"
        },
        "name": {
          "type": "string",
          "pattern": "^netcoredbg-mcp-stateless-preview-win-x64-(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-preview\\.(?:[1-9][0-9]*)\\.zip$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "manifest_asset_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "size_bytes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/github_identifier"
        },
        "name": {
          "type": "string",
          "pattern": "^netcoredbg-mcp-stateless-preview-win-x64-(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-preview\\.(?:[1-9][0-9]*)\\.manifest\\.json$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "archive_asset_absent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "ABSENT"
        }
      }
    },
    "archive_asset_present": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "metadata",
        "downloaded_identity",
        "observed_result",
        "identity_status"
      ],
      "properties": {
        "status": {
          "const": "PRESENT"
        },
        "metadata": {
          "$ref": "#/$defs/archive_asset_metadata"
        },
        "downloaded_identity": {
          "$ref": "#/$defs/archive"
        },
        "observed_result": {
          "$ref": "#/$defs/observed_result_code"
        },
        "identity_status": {
          "enum": [
            "MATCHES_CANDIDATE",
            "METADATA_SIZE_MISMATCH",
            "DOWNLOADED_SIZE_MISMATCH",
            "DOWNLOADED_SHA256_MISMATCH"
          ]
        }
      }
    },
    "archive_asset_present_unreadable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "metadata",
        "reason_code"
      ],
      "properties": {
        "status": {
          "const": "PRESENT_UNREADABLE"
        },
        "metadata": {
          "$ref": "#/$defs/archive_asset_metadata"
        },
        "reason_code": {
          "enum": [
            "ARCHIVE_DOWNLOAD_UNAVAILABLE",
            "ARCHIVE_DOWNLOAD_UNAUTHORIZED",
            "ARCHIVE_DOWNLOAD_INCOMPLETE"
          ]
        }
      }
    },
    "archive_asset_unreadable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code"
      ],
      "properties": {
        "status": {
          "const": "UNREADABLE"
        },
        "reason_code": {
          "enum": [
            "ARCHIVE_READBACK_UNAVAILABLE",
            "ARCHIVE_READBACK_UNAUTHORIZED",
            "ARCHIVE_READBACK_INCOMPLETE"
          ]
        }
      }
    },
    "archive_asset_observation": {
      "oneOf": [
        {
          "$ref": "#/$defs/archive_asset_absent"
        },
        {
          "$ref": "#/$defs/archive_asset_present"
        },
        {
          "$ref": "#/$defs/archive_asset_present_unreadable"
        },
        {
          "$ref": "#/$defs/archive_asset_unreadable"
        }
      ]
    },
    "manifest_asset_absent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "ABSENT"
        }
      }
    },
    "manifest_asset_present": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "metadata",
        "downloaded_identity",
        "observed_result",
        "identity_status"
      ],
      "properties": {
        "status": {
          "const": "PRESENT"
        },
        "metadata": {
          "$ref": "#/$defs/manifest_asset_metadata"
        },
        "downloaded_identity": {
          "$ref": "#/$defs/manifest"
        },
        "observed_result": {
          "$ref": "#/$defs/observed_result_code"
        },
        "identity_status": {
          "enum": [
            "MATCHES_CANDIDATE",
            "METADATA_SIZE_MISMATCH",
            "DOWNLOADED_SIZE_MISMATCH",
            "DOWNLOADED_SHA256_MISMATCH"
          ]
        }
      }
    },
    "manifest_asset_present_unreadable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "metadata",
        "reason_code"
      ],
      "properties": {
        "status": {
          "const": "PRESENT_UNREADABLE"
        },
        "metadata": {
          "$ref": "#/$defs/manifest_asset_metadata"
        },
        "reason_code": {
          "enum": [
            "MANIFEST_DOWNLOAD_UNAVAILABLE",
            "MANIFEST_DOWNLOAD_UNAUTHORIZED",
            "MANIFEST_DOWNLOAD_INCOMPLETE"
          ]
        }
      }
    },
    "manifest_asset_unreadable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code"
      ],
      "properties": {
        "status": {
          "const": "UNREADABLE"
        },
        "reason_code": {
          "enum": [
            "MANIFEST_READBACK_UNAVAILABLE",
            "MANIFEST_READBACK_UNAUTHORIZED",
            "MANIFEST_READBACK_INCOMPLETE"
          ]
        }
      }
    },
    "manifest_asset_observation": {
      "oneOf": [
        {
          "$ref": "#/$defs/manifest_asset_absent"
        },
        {
          "$ref": "#/$defs/manifest_asset_present"
        },
        {
          "$ref": "#/$defs/manifest_asset_present_unreadable"
        },
        {
          "$ref": "#/$defs/manifest_asset_unreadable"
        }
      ]
    },
    "asset_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive",
        "manifest",
        "unexpected_asset_ids"
      ],
      "properties": {
        "archive": {
          "$ref": "#/$defs/archive_asset_observation"
        },
        "manifest": {
          "$ref": "#/$defs/manifest_asset_observation"
        },
        "unexpected_asset_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_opaque_id"
          }
        }
      }
    }
  }
}
