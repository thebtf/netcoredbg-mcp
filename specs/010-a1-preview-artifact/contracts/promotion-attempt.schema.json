{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promotion-attempt.schema.json",
  "title": "A1 preview Promotion Attempt",
  "description": "Immutable Attempt 3.0 admission binds exact-source execution policy, not observed grants or a guarantee of server authorization.",
  "$comment": "Resolve and hash Candidate, Catalog, APPROVE Decision, both passing pre-mutation Stages, Observation 2.0 and classification. Independently captured source/build/checkout/live-main/workflow SHA and both initiators must match the candidate and authorized dispatcher. execution_policy identifies the exact tracked workflow blob and fixed github.token provenance; App/installation IDs stay UNOBSERVED/null. Complete prior-run/attempt/artifact discovery independently determines predecessor_attempt, including evidence for null. Preserve original operation identities, denials and UNKNOWN; no uncertain resend. Chronology: pre-decision <= Decision <= pre-publication <= O0 <= C0 <= A before expiry. PASS is admission only. Reject legacy 1.0/2.0 and retired fields without upgrading history.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "candidate_identity_record",
    "candidate_identity_record_sha256",
    "candidate",
    "promotion_decision",
    "promotion_decision_sha256",
    "pre_decision_stage_evidence",
    "pre_publication_stage_evidence",
    "authorization",
    "workflow_run",
    "remote_observation",
    "remote_classification",
    "predecessor_attempt",
    "admission_status",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "attempt_id": {
      "$ref": "artifact-consumer-proof.schema.json#/$defs/safe_opaque_id"
    },
    "candidate_identity_record": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "candidate_identity_record_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate": {
      "$ref": "candidate-identity.schema.json#/$defs/candidate_binding"
    },
    "promotion_decision": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "promotion_decision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "pre_decision_stage_evidence": {
      "$ref": "#/$defs/passing_pre_decision_stage_evidence"
    },
    "pre_publication_stage_evidence": {
      "$ref": "#/$defs/passing_pre_publication_stage_evidence"
    },
    "authorization": {
      "$ref": "#/$defs/current_attempt_authorization"
    },
    "workflow_run": {
      "$ref": "#/$defs/current_promote_workflow_run"
    },
    "remote_observation": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "remote_classification": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "predecessor_attempt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/github_artifact_file_reference"
        }
      ]
    },
    "admission_status": {
      "const": "PASS"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "$ref": "candidate-identity.schema.json#/$defs/sha256"
    },
    "github_identifier": {
      "$ref": "candidate-identity.schema.json#/$defs/github_identifier"
    },
    "github_repository": {
      "$ref": "candidate-identity.schema.json#/$defs/github_repository"
    },
    "github_artifact_file_reference": {
      "$ref": "candidate-identity.schema.json#/$defs/github_artifact_file_reference"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "stage_evidence_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_reference",
        "candidate_identity_record_sha256",
        "source_ref",
        "source_commit",
        "stage",
        "outcome"
      ],
      "properties": {
        "record_reference": {
          "$ref": "#/$defs/github_artifact_file_reference"
        },
        "candidate_identity_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_ref": {
          "const": "refs/heads/main"
        },
        "source_commit": {
          "$ref": "#/$defs/source_commit"
        },
        "stage": {
          "$ref": "release-gate-catalog.schema.json#/$defs/gate_stage"
        },
        "outcome": {
          "const": "PASS"
        }
      }
    },
    "passing_pre_decision_stage_evidence": {
      "allOf": [
        {
          "$ref": "#/$defs/stage_evidence_receipt"
        },
        {
          "properties": {
            "stage": {
              "const": "pre-decision"
            }
          }
        }
      ]
    },
    "passing_pre_publication_stage_evidence": {
      "allOf": [
        {
          "$ref": "#/$defs/stage_evidence_receipt"
        },
        {
          "properties": {
            "stage": {
              "const": "pre-publication"
            }
          }
        }
      ]
    },
    "github_actor_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "login"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/github_identifier"
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?:\\[bot\\])?$"
        }
      }
    },
    "decision_authorization": {
      "description": "The immutable authorization template that a Promotion Decision names before any promotion run exists.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_author",
        "authorized_dispatcher"
      ],
      "properties": {
        "decision_author": {
          "$ref": "#/$defs/github_actor_identity"
        },
        "authorized_dispatcher": {
          "$ref": "#/$defs/github_actor_identity"
        }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "run_attempt",
        "job_key",
        "job_id",
        "workflow_sha",
        "workflow_blob_sha256",
        "execution_token"
      ],
      "properties": {
        "model": {
          "const": "GITHUB_JOB_TOKEN_SERVER_ENFORCED"
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "job_key": {
          "const": "promote"
        },
        "job_id": {
          "$ref": "#/$defs/github_identifier"
        },
        "workflow_sha": {
          "$ref": "#/$defs/source_commit"
        },
        "workflow_blob_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_token": {
          "$ref": "#/$defs/execution_token_provenance"
        }
      }
    },
    "current_attempt_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_authorization",
        "current_github_actor",
        "current_github_triggering_actor",
        "execution_policy"
      ],
      "properties": {
        "decision_authorization": {
          "$ref": "#/$defs/decision_authorization"
        },
        "current_github_actor": {
          "$ref": "#/$defs/github_actor_identity"
        },
        "current_github_triggering_actor": {
          "$ref": "#/$defs/github_actor_identity"
        },
        "execution_policy": {
          "$ref": "#/$defs/execution_policy"
        }
      }
    },
    "current_promote_workflow_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflow_path",
        "mode",
        "event",
        "run_id",
        "run_attempt",
        "ref",
        "commit"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/github_repository"
        },
        "workflow_path": {
          "const": ".github/workflows/stateless-preview.yml"
        },
        "mode": {
          "const": "promote"
        },
        "event": {
          "const": "workflow_dispatch"
        },
        "run_id": {
          "$ref": "#/$defs/github_identifier"
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "ref": {
          "const": "refs/heads/main"
        },
        "commit": {
          "$ref": "#/$defs/source_commit"
        }
      }
    },
    "execution_token_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "kind",
        "identity_observation",
        "app_id",
        "installation_id"
      ],
      "properties": {
        "source": {
          "const": "github.token"
        },
        "kind": {
          "const": "GITHUB_APP_INSTALLATION_TOKEN"
        },
        "identity_observation": {
          "const": "UNOBSERVED"
        },
        "app_id": {
          "const": null
        },
        "installation_id": {
          "const": null
        }
      }
    },
    "promotion_attempt_reference": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "promotion_decision_document": {
      "$ref": "promotion-decision.schema.json"
    },
    "stage_gate_evidence_document": {
      "$ref": "stage-gate-evidence.schema.json"
    }
  }
}
