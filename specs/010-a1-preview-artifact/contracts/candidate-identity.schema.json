{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native preview Candidate Identity Record",
  "description": "Immutable retained preview identity. Schema 1.0 always means the historical A1 one-tool contract. Schema 2.0 requires a known A2 or A3 manifest (optional-clientInfo, required-metadata/version, or legacy-initialize diagnostic) with its exact consumer catalog ID/hash and three tools; receipt fields cannot select the generation.",
  "$comment": "Semantic validator obligations: CANONICAL_MAIN_SOURCE_PROVENANCE requires source.repository, build.repository, and destination.repository to be equal; source.ref and build.ref to be refs/heads/main; source.commit, source.origin_main_target, and build.commit to be equal; and the build workflow run resolved from GitHub to authenticate repository, workflow path, mode, event, run ID, run attempt, ref, and head SHA. At build admission, the workflow reads origin/main and requires that live ref target to equal source.commit before checkout; a later main advance does not rewrite this sealed source fact. The resolved build workflow run must later conclude successfully before proof or promotion. CANDIDATE_ARTIFACT_REFERENCE_EQUALITY requires both retained-file references to equal the recorded build repository, run_id, and artifact.id. CANDIDATE_MANIFEST_BINDING_EQUALITY requires the manifest reference path and hash to equal file.name and file.sha256, the archive reference path and hash to equal contents.archive.name and contents.archive.sha256, source.commit to equal contents.commit, and destination.tag to equal contents.tag. Sonar receipts are separate post-publication audit evidence, not candidate identity or promotion prerequisites. JSON Schema cannot compare those dynamic values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "candidate": {
      "$ref": "#/$defs/candidate_binding"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.0"
          }
        }
      },
      "then": {
        "properties": {
          "candidate": {
            "properties": {
              "preview_manifest": {
                "properties": {
                  "contents": {
                    "properties": {
                      "schema_version": {
                        "const": "2.0"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "candidate": {
            "properties": {
              "preview_manifest": {
                "properties": {
                  "contents": {
                    "properties": {
                      "schema_version": {
                        "const": "1.0"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "github_identifier": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "github_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "actions_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "sha256",
        "retention"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/github_identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configured_days",
            "expires_at"
          ],
          "properties": {
            "configured_days": {
              "type": "integer",
              "minimum": 1
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "github_artifact_file_reference": {
      "description": "A sealed record or retained file stored in one GitHub Actions artifact. It deliberately has no URI field.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "run_id",
        "artifact_id",
        "path",
        "sha256"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/github_repository"
        },
        "run_id": {
          "$ref": "#/$defs/github_identifier"
        },
        "artifact_id": {
          "$ref": "#/$defs/github_identifier"
        },
        "path": {
          "$ref": "#/$defs/safe_relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "manifest_file": {
      "allOf": [
        {
          "$ref": "../../005-stateless-preview/contracts/preview-manifest.schema.json#/$defs/hashed_file"
        },
        {
          "properties": {
            "name": {
              "pattern": "^netcoredbg-mcp-stateless-preview-win-x64-(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-preview\\.(?:[1-9][0-9]*)\\.manifest\\.json$"
            }
          }
        }
      ]
    },
    "candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "build",
        "preview_manifest",
        "destination"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "ref",
            "commit",
            "origin_main_target"
          ],
          "properties": {
            "repository": {
              "$ref": "#/$defs/github_repository"
            },
            "ref": {
              "const": "refs/heads/main"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "origin_main_target": {
              "description": "The immutable build-admission readback of canonical origin/main, not a later mutable branch lookup.",
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "build": {
          "description": "The trusted workflow-run provenance for the canonical source and retained payload.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "workflow_path",
            "mode",
            "event",
            "run_id",
            "run_attempt",
            "ref",
            "commit",
            "artifact"
          ],
          "properties": {
            "repository": {
              "$ref": "#/$defs/github_repository"
            },
            "workflow_path": {
              "const": ".github/workflows/stateless-preview.yml"
            },
            "mode": {
              "const": "build"
            },
            "event": {
              "const": "workflow_dispatch"
            },
            "run_id": {
              "$ref": "#/$defs/github_identifier"
            },
            "run_attempt": {
              "type": "integer",
              "minimum": 1
            },
            "ref": {
              "const": "refs/heads/main"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "artifact": {
              "$ref": "#/$defs/actions_artifact"
            }
          }
        },
        "preview_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "manifest_reference",
            "archive_reference",
            "contents"
          ],
          "properties": {
            "file": {
              "$ref": "#/$defs/manifest_file"
            },
            "manifest_reference": {
              "$ref": "#/$defs/github_artifact_file_reference"
            },
            "archive_reference": {
              "$ref": "#/$defs/github_artifact_file_reference"
            },
            "contents": {
              "$ref": "../../005-stateless-preview/contracts/preview-manifest.schema.json"
            }
          }
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "repository",
            "tag",
            "prerelease"
          ],
          "properties": {
            "provider": {
              "const": "github"
            },
            "repository": {
              "$ref": "#/$defs/github_repository"
            },
            "tag": {
              "$ref": "../../005-stateless-preview/contracts/preview-manifest.schema.json#/$defs/tag"
            },
            "prerelease": {
              "const": true
            }
          }
        }
      }
    }
  }
}
