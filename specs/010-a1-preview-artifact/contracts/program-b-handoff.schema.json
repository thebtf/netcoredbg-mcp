{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A1 preview Program B Handoff",
  "description": "Immutable, closed A1 closeout record for one published opt-in preview candidate. It proves only A1 opt-in preview completion and requires separate authorization before Program B or Program C work begins.",
  "$comment": "Resolve every structural reference, hash exact bytes and revalidate the complete A1 lineage. Require Candidate/source/build/canonical-main equality, fresh exact APPROVE, Attempt 3.0 execution policy and independent predecessor history, Observation 2.0 results and honestly derived published_complete, genuine pre/post byte proof, fresh public consumer/Python rollback and all three passing Catalog Stages. Both current initiators equal the authorized dispatcher; github.token identity remains UNOBSERVED/null. No permission report or effective-grant claim. Preserve DENIED and UNKNOWN without attribution laundering. This A1-only handoff authorizes neither Program B nor C; Sonar remains separate audit evidence. Outer version remains 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_schema_version",
    "handoff_id",
    "producer",
    "candidate_identity_record",
    "candidate",
    "source_ref",
    "source_commit",
    "approved_promotion_decision",
    "promotion_attempt",
    "promotion_attempt_id",
    "published_remote_observation",
    "published_remote_classification",
    "remote_verification_receipt",
    "remote_consumer_proof",
    "release_gate_catalog",
    "pre_decision_stage_evidence",
    "pre_publication_stage_evidence",
    "post_publication_stage_evidence",
    "completion_scope",
    "program_b_authorization_required",
    "program_c_authorization_required",
    "recorded_at"
  ],
  "properties": {
    "handoff_schema_version": {
      "const": "1.0"
    },
    "handoff_id": {
      "$ref": "#/$defs/safe_opaque_id"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "candidate_identity_record": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "candidate": {
      "$ref": "candidate-identity.schema.json#/$defs/candidate_binding"
    },
    "source_ref": {
      "$ref": "#/$defs/source_ref"
    },
    "source_commit": {
      "$ref": "#/$defs/source_commit"
    },
    "approved_promotion_decision": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "promotion_attempt": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "promotion_attempt_id": {
      "$ref": "#/$defs/safe_opaque_id"
    },
    "published_remote_observation": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "published_remote_classification": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "remote_verification_receipt": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "remote_consumer_proof": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "release_gate_catalog": {
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "pre_decision_stage_evidence": {
      "description": "Passing Stage Gate Evidence for the catalog's pre-decision descriptor subset: retained proof, seven-lens aggregate, and distinct independent PR review.",
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "pre_publication_stage_evidence": {
      "description": "Passing candidate-bound Stage Gate Evidence for the catalog's current empty pre-publication descriptor subset; fresh source, execution-policy, predecessor, and remote-state guards remain required.",
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "post_publication_stage_evidence": {
      "description": "Passing Stage Gate Evidence for the catalog's post-publication descriptor subset: fresh remote consumer and byte proof after the prerelease is public.",
      "$ref": "#/$defs/github_artifact_file_reference"
    },
    "completion_scope": {
      "const": "A1_OPT_IN_PREVIEW_COMPLETE"
    },
    "program_b_authorization_required": {
      "const": true
    },
    "program_c_authorization_required": {
      "const": true
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "$ref": "candidate-identity.schema.json#/$defs/sha256"
    },
    "github_artifact_file_reference": {
      "$ref": "candidate-identity.schema.json#/$defs/github_artifact_file_reference"
    },
    "safe_opaque_id": {
      "$ref": "artifact-consumer-proof.schema.json#/$defs/safe_opaque_id"
    },
    "source_ref": {
      "const": "refs/heads/main"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "helper_path",
        "operation"
      ],
      "properties": {
        "helper_path": {
          "const": "scripts/stateless_preview_artifact.py"
        },
        "operation": {
          "const": "seal_program_b_handoff"
        }
      }
    },
    "candidate_identity_record_document": {
      "$ref": "candidate-identity.schema.json"
    },
    "promotion_decision_document": {
      "$ref": "promotion-decision.schema.json"
    },
    "promotion_attempt_document": {
      "$ref": "promotion-attempt.schema.json"
    },
    "artifact_consumer_proof_document": {
      "$ref": "artifact-consumer-proof.schema.json"
    },
    "s2_s3_review_document": {
      "$ref": "s2-s3-review.schema.json"
    },
    "remote_observation_document": {
      "$ref": "remote-observation.schema.json"
    },
    "remote_classification_document": {
      "$ref": "remote-classification.schema.json"
    },
    "remote_verification_document": {
      "$ref": "remote-verification.schema.json"
    },
    "release_gate_catalog_document": {
      "$ref": "release-gate-catalog.schema.json"
    },
    "stage_gate_evidence_document": {
      "$ref": "stage-gate-evidence.schema.json"
    }
  }
}