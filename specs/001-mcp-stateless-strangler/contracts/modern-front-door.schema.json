{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "netcoredbg.mcp.stateless-strangler.m1.application",
  "title": "Milestone M1 application payloads and tool inputs",
  "description": "Application-scoped schemas only. Official MCP schemas define envelopes, discovery/list/call, request metadata, cache fields, CallToolResult, InputRequiredResult, inputResponses, and version errors.",
  "$ref": "#/$defs/toolStructuredContent",
  "$defs": {
    "debugSessionId": {
      "type": "string",
      "minLength": 32,
      "description": "Opaque server-minted process-local capability; format is private. `required`/`minLength` advertise a valid capability-bearing call. Direct runtime maps a missing `debugSessionId` or non-empty short/malformed token string uniformly to not-found; empty/whitespace, non-string, and extra-field shapes are invalid arguments."
    },
    "lifecycleState": {
      "type": "object",
      "required": [
        "event",
        "stopReason",
        "exitCode"
      ],
      "properties": {
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "stopReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "startDebugArguments": {
      "type": "object",
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "debugSessionArguments": {
      "type": "object",
      "required": [
        "debugSessionId"
      ],
      "properties": {
        "debugSessionId": {
          "$ref": "#/$defs/debugSessionId"
        }
      },
      "additionalProperties": false
    },
    "getThreadsArguments": {
      "type": "object",
      "required": [
        "debugSessionId"
      ],
      "properties": {
        "debugSessionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "getCallStackArguments": {
      "type": "object",
      "required": [
        "debugSessionId",
        "threadId"
      ],
      "properties": {
        "debugSessionId": {
          "type": "string",
          "minLength": 1
        },
        "threadId": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "levels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "additionalProperties": false
    },
    "startDebugSuccess": {
      "type": "object",
      "required": [
        "kind",
        "debugSessionId",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "start_debug_success"
        },
        "debugSessionId": {
          "$ref": "#/$defs/debugSessionId"
        },
        "state": {
          "$ref": "#/$defs/lifecycleState"
        }
      },
      "additionalProperties": false
    },
    "debugStateSuccess": {
      "type": "object",
      "required": [
        "kind",
        "debugSessionId",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "debug_state_success"
        },
        "debugSessionId": {
          "$ref": "#/$defs/debugSessionId"
        },
        "state": {
          "$ref": "#/$defs/lifecycleState"
        }
      },
      "additionalProperties": false
    },
    "stopDebugSuccess": {
      "type": "object",
      "required": [
        "kind",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "stop_debug_success"
        },
        "state": {
          "$ref": "#/$defs/lifecycleState"
        }
      },
      "additionalProperties": false
    },
    "thread": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "threadsSuccess": {
      "type": "object",
      "required": [
        "kind",
        "threads"
      ],
      "properties": {
        "kind": {
          "const": "threads_success"
        },
        "threads": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/thread"
          }
        }
      },
      "additionalProperties": false
    },
    "stackFrame": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source",
        "line",
        "column"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "callStackSuccess": {
      "type": "object",
      "required": [
        "kind",
        "frames"
      ],
      "properties": {
        "kind": {
          "const": "call_stack_success"
        },
        "frames": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/stackFrame"
          }
        },
        "totalFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    },
    "debugSessionNotFound": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "debug_session_not_found"
        },
        "error": {
          "const": "DEBUG_SESSION_NOT_FOUND"
        }
      },
      "additionalProperties": false
    },
    "dapThreadsRefused": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_threads_refused"
        },
        "error": {
          "const": "DAP_THREADS_REFUSED"
        }
      },
      "additionalProperties": false
    },
    "dapThreadsProtocolError": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_threads_protocol_error"
        },
        "error": {
          "const": "DAP_THREADS_PROTOCOL_ERROR"
        }
      },
      "additionalProperties": false
    },
    "dapStackTraceRefused": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_stack_trace_refused"
        },
        "error": {
          "const": "DAP_STACK_TRACE_REFUSED"
        }
      },
      "additionalProperties": false
    },
    "dapStackTraceProtocolError": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_stack_trace_protocol_error"
        },
        "error": {
          "const": "DAP_STACK_TRACE_PROTOCOL_ERROR"
        }
      },
      "additionalProperties": false
    },
    "missingProgramCapability": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "start_debug_input_unavailable"
        },
        "error": {
          "const": "START_DEBUG_PROGRAM_REQUIRED"
        }
      },
      "additionalProperties": false
    },
    "invalidToolArguments": {
      "type": "object",
      "required": [
        "kind",
        "error",
        "tool"
      ],
      "properties": {
        "kind": {
          "const": "invalid_tool_arguments"
        },
        "error": {
          "const": "INVALID_TOOL_ARGUMENTS"
        },
        "tool": {
          "enum": [
            "start_debug",
            "get_debug_state",
            "stop_debug",
            "get_threads",
            "get_call_stack"
          ]
        }
      },
      "additionalProperties": false
    },
    "toolStructuredContent": {
      "oneOf": [
        {
          "$ref": "#/$defs/startDebugSuccess"
        },
        {
          "$ref": "#/$defs/debugStateSuccess"
        },
        {
          "$ref": "#/$defs/stopDebugSuccess"
        },
        {
          "$ref": "#/$defs/threadsSuccess"
        },
        {
          "$ref": "#/$defs/callStackSuccess"
        },
        {
          "$ref": "#/$defs/debugSessionNotFound"
        },
        {
          "$ref": "#/$defs/missingProgramCapability"
        },
        {
          "$ref": "#/$defs/dapThreadsRefused"
        },
        {
          "$ref": "#/$defs/dapThreadsProtocolError"
        },
        {
          "$ref": "#/$defs/dapStackTraceRefused"
        },
        {
          "$ref": "#/$defs/dapStackTraceProtocolError"
        },
        {
          "$ref": "#/$defs/invalidToolArguments"
        }
      ]
    }
  }
}
