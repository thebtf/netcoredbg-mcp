{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "netcoredbg.mcp.stateless-strangler.m1.application",
  "title": "Milestone M1 application payloads and tool inputs",
  "description": "Application-scoped schemas only. Official MCP schemas define envelopes, discovery/list/call, request metadata, cache fields, CallToolResult, InputRequiredResult, inputResponses, and version errors.",
  "$ref": "#/$defs/toolStructuredContent",
  "$defs": {
    "debugSessionId": {
      "type": "string",
      "minLength": 32,
      "description": "Opaque server-minted process-local capability; format is private. `required`/`minLength` advertise a valid capability-bearing call. Direct runtime maps a missing `debugSessionId` or non-empty short/malformed token string uniformly to not-found; empty/whitespace, non-string, and extra-field shapes are invalid arguments."
    },
    "inspectionContextId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S",
      "description": "Opaque process/session-local stopped-epoch token, obtained only from a successful get_call_stack with includeInspectionContext=true. Carry each numeric ID with the context from the same observation; the token does not prove that the numeric ID was ever issued. Execution, stopped replacement, terminal, invalidated, thread-exit, reader failure and cleanup invalidate the inspection epoch session-wide."
    },
    "lifecycleState": {
      "type": "object",
      "required": [
        "event",
        "stopReason",
        "exitCode"
      ],
      "properties": {
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "stopReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "currentThreadId": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "startDebugArguments": {
      "type": "object",
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        },
        "breakpoints": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/sourceBreakpoint"
          }
        }
      },
      "additionalProperties": false
    },
    "sourceBreakpoint": {
      "type": "object",
      "required": [
        "file",
        "line"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "initialBreakpoint": {
      "type": "object",
      "description": "Initial setBreakpoints response only; not a breakpoint-hit or later verification report.",
      "required": [
        "index",
        "verified"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "verified": {
          "type": "boolean"
        },
        "actualLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "debugSessionArguments": {
      "type": "object",
      "required": [
        "debugSessionId"
      ],
      "properties": {
        "debugSessionId": {
          "$ref": "#/$defs/debugSessionId"
        }
      },
      "additionalProperties": false
    },
    "getThreadsArguments": {
      "type": "object",
      "required": [
        "debugSessionId"
      ],
      "properties": {
        "debugSessionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "getCallStackArguments": {
      "type": "object",
      "required": [
        "debugSessionId",
        "threadId"
      ],
      "properties": {
        "debugSessionId": {
          "type": "string",
          "minLength": 1
        },
        "threadId": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "levels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "includeInspectionContext": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "getScopesArguments": {
      "type": "object",
      "required": [
        "debugSessionId",
        "inspectionContextId",
        "frameId"
      ],
      "properties": {
        "debugSessionId": {
          "type": "string",
          "minLength": 1
        },
        "inspectionContextId": {
          "$ref": "#/$defs/inspectionContextId"
        },
        "frameId": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "getVariablesArguments": {
      "type": "object",
      "required": [
        "debugSessionId",
        "inspectionContextId",
        "variablesReference"
      ],
      "properties": {
        "debugSessionId": {
          "type": "string",
          "minLength": 1
        },
        "inspectionContextId": {
          "$ref": "#/$defs/inspectionContextId"
        },
        "variablesReference": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "stepOverArguments": {
      "type": "object",
      "required": [
        "debugSessionId",
        "threadId"
      ],
      "properties": {
        "debugSessionId": {
          "type": "string",
          "minLength": 1
        },
        "threadId": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "startDebugSuccess": {
      "type": "object",
      "required": [
        "kind",
        "debugSessionId",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "start_debug_success"
        },
        "debugSessionId": {
          "$ref": "#/$defs/debugSessionId"
        },
        "state": {
          "$ref": "#/$defs/lifecycleState"
        },
        "initialBreakpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/initialBreakpoint"
          }
        }
      },
      "additionalProperties": false
    },
    "debugStateSuccess": {
      "type": "object",
      "required": [
        "kind",
        "debugSessionId",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "debug_state_success"
        },
        "debugSessionId": {
          "$ref": "#/$defs/debugSessionId"
        },
        "state": {
          "$ref": "#/$defs/lifecycleState"
        }
      },
      "additionalProperties": false
    },
    "stopDebugSuccess": {
      "type": "object",
      "required": [
        "kind",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "stop_debug_success"
        },
        "state": {
          "$ref": "#/$defs/lifecycleState"
        }
      },
      "additionalProperties": false
    },
    "thread": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "threadsSuccess": {
      "type": "object",
      "required": [
        "kind",
        "threads"
      ],
      "properties": {
        "kind": {
          "const": "threads_success"
        },
        "threads": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/thread"
          }
        }
      },
      "additionalProperties": false
    },
    "stackFrame": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source",
        "line",
        "column"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "callStackSuccess": {
      "type": "object",
      "required": [
        "kind",
        "frames"
      ],
      "properties": {
        "kind": {
          "const": "call_stack_success"
        },
        "frames": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/stackFrame"
          }
        },
        "totalFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "inspectionContextId": {
          "$ref": "#/$defs/inspectionContextId"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "name",
        "variablesReference",
        "expensive"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 1024,
          "description": "Runtime additionally enforces a maximum of 1024 UTF-8 bytes."
        },
        "variablesReference": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "expensive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "required": [
        "name",
        "value",
        "type",
        "variablesReference"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 1024,
          "description": "Runtime additionally enforces a maximum of 1024 UTF-8 bytes."
        },
        "value": {
          "type": "string",
          "description": "No smaller per-value limit; the complete serialized success structuredContent is bounded to 262144 UTF-8 bytes inclusive."
        },
        "type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024,
          "description": "Null when the adapter omits type. Runtime limits a present string to 1024 UTF-8 bytes."
        },
        "variablesReference": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "Zero marks an output leaf only and is never valid as get_variables input."
        }
      },
      "additionalProperties": false
    },
    "scopesSuccess": {
      "type": "object",
      "description": "Complete serialized structuredContent is bounded to 262144 UTF-8 bytes inclusive.",
      "required": [
        "kind",
        "inspectionContextId",
        "scopes"
      ],
      "properties": {
        "kind": {
          "const": "scopes_success"
        },
        "inspectionContextId": {
          "$ref": "#/$defs/inspectionContextId"
        },
        "scopes": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/scope"
          }
        }
      },
      "additionalProperties": false
    },
    "variablesSuccess": {
      "type": "object",
      "description": "Complete serialized structuredContent is bounded to 262144 UTF-8 bytes inclusive.",
      "required": [
        "kind",
        "inspectionContextId",
        "variables"
      ],
      "properties": {
        "kind": {
          "const": "variables_success"
        },
        "inspectionContextId": {
          "$ref": "#/$defs/inspectionContextId"
        },
        "variables": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/variable"
          }
        }
      },
      "additionalProperties": false
    },
    "stepOverSuccess": {
      "type": "object",
      "required": [
        "kind",
        "threadId"
      ],
      "properties": {
        "kind": {
          "const": "step_over_success"
        },
        "threadId": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "stepOverTerminal": {
      "type": "object",
      "required": [
        "kind",
        "terminal"
      ],
      "properties": {
        "kind": {
          "const": "step_over_terminal"
        },
        "terminal": {
          "enum": [
            "exited",
            "terminated"
          ]
        },
        "exitCode": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "stepOverTimedOut": {
      "type": "object",
      "required": [
        "kind",
        "threadId",
        "timeoutSeconds"
      ],
      "properties": {
        "kind": {
          "const": "step_over_timed_out"
        },
        "threadId": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 30
        }
      },
      "additionalProperties": false
    },
    "debugSessionNotFound": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "debug_session_not_found"
        },
        "error": {
          "const": "DEBUG_SESSION_NOT_FOUND"
        }
      },
      "additionalProperties": false
    },
    "dapThreadsRefused": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_threads_refused"
        },
        "error": {
          "const": "DAP_THREADS_REFUSED"
        }
      },
      "additionalProperties": false
    },
    "dapThreadsProtocolError": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_threads_protocol_error"
        },
        "error": {
          "const": "DAP_THREADS_PROTOCOL_ERROR"
        }
      },
      "additionalProperties": false
    },
    "dapStackTraceRefused": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_stack_trace_refused"
        },
        "error": {
          "const": "DAP_STACK_TRACE_REFUSED"
        }
      },
      "additionalProperties": false
    },
    "dapStackTraceProtocolError": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_stack_trace_protocol_error"
        },
        "error": {
          "const": "DAP_STACK_TRACE_PROTOCOL_ERROR"
        }
      },
      "additionalProperties": false
    },
    "dapScopesRefused": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_scopes_refused"
        },
        "error": {
          "const": "DAP_SCOPES_REFUSED"
        }
      },
      "additionalProperties": false
    },
    "dapScopesProtocolError": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_scopes_protocol_error"
        },
        "error": {
          "const": "DAP_SCOPES_PROTOCOL_ERROR"
        }
      },
      "additionalProperties": false
    },
    "dapVariablesRefused": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_variables_refused"
        },
        "error": {
          "const": "DAP_VARIABLES_REFUSED"
        }
      },
      "additionalProperties": false
    },
    "dapVariablesProtocolError": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_variables_protocol_error"
        },
        "error": {
          "const": "DAP_VARIABLES_PROTOCOL_ERROR"
        }
      },
      "additionalProperties": false
    },
    "dapStepOverRefused": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_step_over_refused"
        },
        "error": {
          "const": "DAP_STEP_OVER_REFUSED"
        }
      },
      "additionalProperties": false
    },
    "dapStepOverProtocolError": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_step_over_protocol_error"
        },
        "error": {
          "const": "DAP_STEP_OVER_PROTOCOL_ERROR"
        }
      },
      "additionalProperties": false
    },
    "startDebugSourceUnavailable": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "start_debug_source_unavailable"
        },
        "error": {
          "const": "START_DEBUG_SOURCE_UNAVAILABLE"
        }
      },
      "additionalProperties": false
    },
    "dapBreakpointsRefused": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_breakpoints_refused"
        },
        "error": {
          "const": "DAP_BREAKPOINTS_REFUSED"
        }
      },
      "additionalProperties": false
    },
    "dapBreakpointsProtocolError": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "dap_breakpoints_protocol_error"
        },
        "error": {
          "const": "DAP_BREAKPOINTS_PROTOCOL_ERROR"
        }
      },
      "additionalProperties": false
    },
    "missingProgramCapability": {
      "type": "object",
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "start_debug_input_unavailable"
        },
        "error": {
          "const": "START_DEBUG_PROGRAM_REQUIRED"
        }
      },
      "additionalProperties": false
    },
    "invalidToolArguments": {
      "type": "object",
      "required": [
        "kind",
        "error",
        "tool"
      ],
      "properties": {
        "kind": {
          "const": "invalid_tool_arguments"
        },
        "error": {
          "const": "INVALID_TOOL_ARGUMENTS"
        },
        "tool": {
          "enum": [
            "start_debug",
            "get_debug_state",
            "stop_debug",
            "get_threads",
            "get_call_stack",
            "get_scopes",
            "get_variables",
            "step_over"
          ]
        }
      },
      "additionalProperties": false
    },
    "toolStructuredContent": {
      "oneOf": [
        {
          "$ref": "#/$defs/startDebugSuccess"
        },
        {
          "$ref": "#/$defs/debugStateSuccess"
        },
        {
          "$ref": "#/$defs/stopDebugSuccess"
        },
        {
          "$ref": "#/$defs/threadsSuccess"
        },
        {
          "$ref": "#/$defs/callStackSuccess"
        },
        {
          "$ref": "#/$defs/scopesSuccess"
        },
        {
          "$ref": "#/$defs/variablesSuccess"
        },
        {
          "$ref": "#/$defs/stepOverSuccess"
        },
        {
          "$ref": "#/$defs/stepOverTerminal"
        },
        {
          "$ref": "#/$defs/stepOverTimedOut"
        },
        {
          "$ref": "#/$defs/debugSessionNotFound"
        },
        {
          "$ref": "#/$defs/missingProgramCapability"
        },
        {
          "$ref": "#/$defs/dapThreadsRefused"
        },
        {
          "$ref": "#/$defs/dapThreadsProtocolError"
        },
        {
          "$ref": "#/$defs/dapStackTraceRefused"
        },
        {
          "$ref": "#/$defs/dapStackTraceProtocolError"
        },
        {
          "$ref": "#/$defs/dapScopesRefused"
        },
        {
          "$ref": "#/$defs/dapScopesProtocolError"
        },
        {
          "$ref": "#/$defs/dapVariablesRefused"
        },
        {
          "$ref": "#/$defs/dapVariablesProtocolError"
        },
        {
          "$ref": "#/$defs/dapStepOverRefused"
        },
        {
          "$ref": "#/$defs/dapStepOverProtocolError"
        },
        {
          "$ref": "#/$defs/startDebugSourceUnavailable"
        },
        {
          "$ref": "#/$defs/dapBreakpointsRefused"
        },
        {
          "$ref": "#/$defs/dapBreakpointsProtocolError"
        },
        {
          "$ref": "#/$defs/invalidToolArguments"
        }
      ]
    }
  }
}
